{
    "title": "Canada Dentist Directory Scraper Input",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "keyword": {
            "title": "Keyword",
            "type": "string",
            "description": "The specific dental niche (e.g., 'dentist', 'orthodontist').",
            "editor": "textfield",
            "prefill": "dentist"
        },
        "location": {
            "title": "Location (City, Province)",
            "type": "string",
            "description": "The Canadian location (e.g., 'Toronto, ON', 'Vancouver, BC').",
            "editor": "textfield",
            "prefill": "Toronto, ON"
        },
        "maxLeads": {
            "title": "Maximum Leads",
            "type": "integer",
            "description": "Maximum number of Canadian dental leads to extract.",
            "default": 100,
            "minimum": 1
        },
        "proxyConfiguration": {
            "title": "Proxy Configuration",
            "type": "object",
            "description": "Proxy settings. Apify Residential Proxy (Canada targeted) is required.",
            "prefill": { "useApifyProxy": true },
            "editor": "proxy"
        }
    },
    "required": ["keyword", "location"]
}
